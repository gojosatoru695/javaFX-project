<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.atmosphere.controller.ComparisonController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="dashboard-scroll">

    <content>
        <VBox spacing="24" styleClass="dashboard-content">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32" />
            </padding>

            <!-- ROW 1: HEADER & CITY CONTROLS -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="City Comparison Studio" styleClass="page-title" />
                        <Label text="MULTI-OBSERVATORY" styleClass="observatory-tag" />
                    </HBox>
                    <Label text="Head-to-head multi-city intelligence evaluated against your Personal Weather DNA"
                           styleClass="subtitle" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- QUICK CITY SEARCH & ADD -->
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <TextField fx:id="addCitySearchField"
                               promptText="Add city to compare..."
                               prefWidth="220"
                               styleClass="search-field" />
                    <Button fx:id="addCityButton"
                            text="+ Add City"
                            onAction="#handleAddCityFromSearch"
                            styleClass="primary-button" />
                </HBox>
            </HBox>

            <!-- STATUS / FEEDBACK -->
            <Label fx:id="comparisonStatusLabel"
                   text="Comparing selected cities. Select between 2 and 4 locations."
                   styleClass="status-text"
                   wrapText="true" />

            <!-- ROW 2: INTELLIGENT RECOMMENDATION BANNER (WINNER CROWN) -->
            <VBox fx:id="recommendationBox" spacing="12" styleClass="comparison-winner-card">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <Label text="👑" styleClass="winner-crown" />
                    <VBox spacing="2">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="winnerCityTitle" text="Optimal Match: Bengaluru" styleClass="winner-title" />
                            <Label fx:id="winnerScoreBadge" text="Score: 88/100 · Optimal" styleClass="badge badge-optimal" />
                        </HBox>
                        <Label text="Ranked #1 according to your Personal Weather DNA preferences" styleClass="metric-hint" />
                    </VBox>
                </HBox>

                <Label fx:id="winnerExplanationLabel"
                       text="Bengaluru leads with optimal temperature (22.4°C) and pristine air quality (AQI 1), making it the most comfortable location right now."
                       styleClass="winner-explanation"
                       wrapText="true" />

                <!-- DIFFERENCE HIGHLIGHTS -->
                <HBox fx:id="winnerHighlightsBox" spacing="10" />
            </VBox>

            <!-- ROW 3: SIDE-BY-SIDE HERO COMPARISON CARDS -->
            <VBox spacing="12">
                <HBox alignment="CENTER_LEFT">
                    <Label text="HEAD-TO-HEAD METRICS" styleClass="section-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Comparing live OpenWeatherMap metrics" styleClass="metric-hint" />
                </HBox>

                <HBox fx:id="cityCardsContainer" spacing="16" alignment="TOP_CENTER" />
            </VBox>

            <!-- ROW 4: DIRECT METRIC COMPARISON MATRIX -->
            <VBox spacing="14" styleClass="card">
                <HBox alignment="CENTER_LEFT">
                    <Label text="COMPARATIVE MATRIX &amp; DIFFERENCE INDICATORS" styleClass="section-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Relative variance across key climate parameters" styleClass="metric-hint" />
                </HBox>

                <VBox fx:id="metricMatrixContainer" spacing="10" />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
