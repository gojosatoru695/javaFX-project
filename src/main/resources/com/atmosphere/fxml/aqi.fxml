<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.atmosphere.controller.AQIController"
      spacing="24"
      styleClass="screen-root">

    <padding>
        <Insets top="32" right="32" bottom="32" left="32" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="16">
            <children>
                <VBox spacing="5">
                    <Label text="Air Quality"
                           styleClass="page-title" />

                    <Label text="Pollution levels and health advisory"
                           styleClass="subtitle" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <ComboBox fx:id="citySelector"
                          prefWidth="200"
                          promptText="Select city"
                          styleClass="search-field" />
            </children>
        </HBox>

        <HBox spacing="24" alignment="TOP_CENTER">
            <children>

                <VBox prefWidth="340"
                      minWidth="320"
                      alignment="CENTER"
                      spacing="14"
                      styleClass="card">

                    <children>
                        <Label text="AQI INDEX"
                               styleClass="section-title" />

                        <StackPane prefWidth="280"
                                   prefHeight="280"
                                   minWidth="280"
                                   minHeight="280">

                            <children>
                                <Canvas fx:id="gaugeCanvas"
                                        width="280"
                                        height="280" />
                            </children>
                        </StackPane>

                        <Label fx:id="gaugeStatusLabel"
                               text="Waiting for air-quality data…"
                               styleClass="status-text"
                               wrapText="true" />
                    </children>
                </VBox>

                <VBox spacing="16" HBox.hgrow="ALWAYS">
                    <children>

                        <VBox spacing="10" styleClass="card">
                            <Label text="HEALTH ADVISORY"
                                   styleClass="section-title" />

                            <Label fx:id="healthAdvisoryLabel"
                                   text="Select a city to load its air-quality advisory."
                                   styleClass="health-advisory-text"
                                   wrapText="true" />

                            <Label fx:id="aqiSourceLabel"
                                   text="AQI data · OpenWeatherMap"
                                   styleClass="status-text" />
                        </VBox>

                        <GridPane hgap="16" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" />
                                <ColumnConstraints percentWidth="50" />
                            </columnConstraints>

                            <children>
                                <VBox spacing="10"
                                      styleClass="card pollutant-card"
                                      GridPane.rowIndex="0"
                                      GridPane.columnIndex="0">

                                    <Label text="PM2.5"
                                           styleClass="section-title" />

                                    <Label fx:id="pm25ValueLabel"
                                           text="— µg/m³"
                                           styleClass="stat-value" />

                                    <ProgressBar fx:id="pm25Progress"
                                                 progress="0"
                                                 maxWidth="Infinity"
                                                 styleClass="pollutant-progress" />
                                </VBox>

                                <VBox spacing="10"
                                      styleClass="card pollutant-card"
                                      GridPane.rowIndex="0"
                                      GridPane.columnIndex="1">

                                    <Label text="PM10"
                                           styleClass="section-title" />

                                    <Label fx:id="pm10ValueLabel"
                                           text="— µg/m³"
                                           styleClass="stat-value" />

                                    <ProgressBar fx:id="pm10Progress"
                                                 progress="0"
                                                 maxWidth="Infinity"
                                                 styleClass="pollutant-progress" />
                                </VBox>

                                <VBox spacing="10"
                                      styleClass="card pollutant-card"
                                      GridPane.rowIndex="1"
                                      GridPane.columnIndex="0">

                                    <Label text="NO₂"
                                           styleClass="section-title" />

                                    <Label fx:id="no2ValueLabel"
                                           text="— µg/m³"
                                           styleClass="stat-value" />

                                    <ProgressBar fx:id="no2Progress"
                                                 progress="0"
                                                 maxWidth="Infinity"
                                                 styleClass="pollutant-progress" />
                                </VBox>

                                <VBox spacing="10"
                                      styleClass="card pollutant-card"
                                      GridPane.rowIndex="1"
                                      GridPane.columnIndex="1">

                                    <Label text="O₃"
                                           styleClass="section-title" />

                                    <Label fx:id="o3ValueLabel"
                                           text="— µg/m³"
                                           styleClass="stat-value" />

                                    <ProgressBar fx:id="o3Progress"
                                                 progress="0"
                                                 maxWidth="Infinity"
                                                 styleClass="pollutant-progress" />
                                </VBox>
                            </children>
                        </GridPane>

                        <Label fx:id="aqiErrorLabel"
                               text=""
                               styleClass="error-text"
                               wrapText="true"
                               visible="false"
                               managed="false" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
