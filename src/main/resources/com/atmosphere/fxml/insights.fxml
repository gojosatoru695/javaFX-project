<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.atmosphere.controller.InsightsController"
      spacing="24"
      styleClass="screen-root">

    <padding>
        <Insets top="32" right="32" bottom="32" left="32" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="16">
            <children>
                <VBox spacing="5">
                    <Label text="AI Insights"
                           styleClass="page-title" />

                    <Label text="✨ Powered by Gemini"
                           styleClass="subtitle" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <ComboBox fx:id="citySelector"
                          prefWidth="200"
                          promptText="Select city"
                          styleClass="search-field" />
            </children>
        </HBox>

        <VBox spacing="22"
              styleClass="card"
              VBox.vgrow="ALWAYS">

            <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="✨"
                           styleClass="insight-sparkle" />

                    <Label text="Weather Intelligence"
                           styleClass="insight-heading" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Label text="GEMINI AI"
                           styleClass="badge badge-blue" />
                </HBox>

                <StackPane fx:id="typingIndicator"
                           minHeight="220"
                           prefHeight="260"
                           alignment="CENTER">

                    <children>
                        <HBox alignment="CENTER" spacing="12">
                            <Circle fx:id="typingDotOne"
                                    radius="6"
                                    styleClass="typing-dot" />

                            <Circle fx:id="typingDotTwo"
                                    radius="6"
                                    styleClass="typing-dot" />

                            <Circle fx:id="typingDotThree"
                                    radius="6"
                                    styleClass="typing-dot" />
                        </HBox>
                    </children>
                </StackPane>

                <TextArea fx:id="insightTextArea"
                          editable="false"
                          wrapText="true"
                          prefRowCount="9"
                          promptText="Your weather insight will appear here…"
                          styleClass="insight-text-area"
                          visible="false"
                          managed="false"
                          VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4">
                        <Label fx:id="cityTimestampLabel"
                               text="Waiting for weather data…"
                               styleClass="stat-value" />

                        <Label fx:id="insightStatusLabel"
                               text="Gemini will turn current conditions into a practical daily note."
                               styleClass="status-text" />
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <Button fx:id="regenerateButton"
                            text="↻  Regenerate"
                            onAction="#handleRegenerate"
                            styleClass="primary-button"
                            disable="true" />
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
