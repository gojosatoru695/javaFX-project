<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.atmosphere.controller.WeatherDnaController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="dashboard-scroll">

    <content>
        <VBox spacing="24" styleClass="dashboard-content">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32" />
            </padding>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Personal Weather DNA" styleClass="page-title" />
                        <Label text="BIOMETRIC PROFILE" styleClass="observatory-tag" />
                    </HBox>
                    <Label text="Configure your personal climate tolerance thresholds and deterministic scoring weights"
                           styleClass="subtitle" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="resetDefaultsButton"
                        text="Reset to Defaults"
                        onAction="#handleResetDefaults"
                        styleClass="secondary-button" />
                <Button fx:id="saveButton"
                        text="Save DNA Profile"
                        onAction="#handleSave"
                        styleClass="primary-button" />
            </HBox>

            <Label fx:id="statusFeedbackLabel"
                   text="Adjust sliders below to customize your comfort scoring engine. Changes reflect instantly in the live simulator."
                   styleClass="status-text"
                   wrapText="true" />

            <!-- MAIN TWO-COLUMN WORKSPACE -->
            <HBox spacing="24" alignment="TOP_CENTER">

                <!-- LEFT COLUMN: PREFERENCE CONTROLS -->
                <VBox spacing="20" HBox.hgrow="ALWAYS" prefWidth="480" styleClass="dna-panel">

                    <Label text="PREFERENCE THRESHOLDS" styleClass="section-title" />

                    <!-- TEMPERATURE RANGE -->
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="TEMPERATURE RANGE" styleClass="stat-label" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="tempRangeValueLabel" text="18.0°C – 26.0°C" styleClass="stat-value" />
                        </HBox>
                        <Label text="Minimum comfortable temperature" styleClass="metric-hint" />
                        <Slider fx:id="minTempSlider" min="0" max="35" value="18" blockIncrement="1" showTickMarks="false" />
                        <Label text="Maximum comfortable temperature" styleClass="metric-hint" />
                        <Slider fx:id="maxTempSlider" min="15" max="45" value="26" blockIncrement="1" showTickMarks="false" />
                    </VBox>

                    <!-- HUMIDITY RANGE -->
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="HUMIDITY RANGE" styleClass="stat-label" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="humidityRangeValueLabel" text="35% – 65%" styleClass="stat-value" />
                        </HBox>
                        <Label text="Minimum humidity" styleClass="metric-hint" />
                        <Slider fx:id="minHumiditySlider" min="10" max="60" value="35" blockIncrement="5" />
                        <Label text="Maximum humidity" styleClass="metric-hint" />
                        <Slider fx:id="maxHumiditySlider" min="40" max="95" value="65" blockIncrement="5" />
                    </VBox>

                    <!-- WIND TOLERANCE -->
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="MAXIMUM COMFORTABLE WIND" styleClass="stat-label" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="maxWindValueLabel" text="20.0 km/h" styleClass="stat-value" />
                        </HBox>
                        <Label text="Wind speeds above this threshold reduce comfort score" styleClass="metric-hint" />
                        <Slider fx:id="maxWindSlider" min="5" max="60" value="20" blockIncrement="1" />
                    </VBox>

                    <!-- AIR QUALITY SENSITIVITY -->
                    <VBox spacing="8">
                        <Label text="AIR QUALITY SENSITIVITY" styleClass="stat-label" />
                        <Label text="Adjusts the severity of penalties for moderate and poor AQI" styleClass="metric-hint" />
                        <ComboBox fx:id="aqiSensitivityComboBox" maxWidth="Infinity" styleClass="search-field" />
                    </VBox>
                </VBox>

                <!-- RIGHT COLUMN: LIVE COMFORT SIMULATOR & EXPLANATION -->
                <VBox spacing="20" HBox.hgrow="ALWAYS" prefWidth="480" styleClass="dna-panel">

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="2">
                            <Label text="LIVE COMFORT SIMULATOR" styleClass="section-title" />
                            <Label text="Evaluates against selected city or simulation preset" styleClass="status-text" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="evalCitySelector" prefWidth="170" styleClass="search-field" />
                    </HBox>

                    <!-- OVERALL SCORE DISPLAY -->
                    <HBox alignment="CENTER" spacing="20" styleClass="card-elevated">
                        <VBox alignment="CENTER" spacing="4">
                            <Label text="COMFORT SCORE" styleClass="stat-label" />
                            <Label fx:id="overallScoreLabel" text="84" styleClass="dna-score-display" />
                            <Label text="out of 100" styleClass="status-text" />
                        </VBox>
                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label fx:id="categoryBadge" text="FAVORABLE" styleClass="badge badge-favorable" />
                            <Label fx:id="simulatedCityConditionLabel" text="Bengaluru · 22.4°C · AQI 1" styleClass="metric-value-small" />
                            <Label text="Deterministic weighting formula active" styleClass="metric-hint" />
                        </VBox>
                    </HBox>

                    <!-- FACTOR CONTRIBUTIONS -->
                    <VBox spacing="14">
                        <Label text="FACTOR BREAKDOWN &amp; WEIGHTED CONTRIBUTIONS" styleClass="section-title" />

                        <!-- Temperature factor -->
                        <VBox spacing="4">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Temperature (40% weight)" styleClass="status-text" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="tempFactorLabel" text="40.0 / 40 pts (100%)" styleClass="stat-value" />
                            </HBox>
                            <ProgressBar fx:id="tempFactorProgress" progress="1.0" maxWidth="Infinity" styleClass="dna-factor-bar" />
                        </VBox>

                        <!-- Air Quality factor -->
                        <VBox spacing="4">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Air Quality (25% weight)" styleClass="status-text" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="aqiFactorLabel" text="25.0 / 25 pts (100%)" styleClass="stat-value" />
                            </HBox>
                            <ProgressBar fx:id="aqiFactorProgress" progress="1.0" maxWidth="Infinity" styleClass="dna-factor-bar" />
                        </VBox>

                        <!-- Wind factor -->
                        <VBox spacing="4">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Wind Speed (20% weight)" styleClass="status-text" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="windFactorLabel" text="18.4 / 20 pts (92%)" styleClass="stat-value" />
                            </HBox>
                            <ProgressBar fx:id="windFactorProgress" progress="0.92" maxWidth="Infinity" styleClass="dna-factor-bar" />
                        </VBox>

                        <!-- Humidity factor -->
                        <VBox spacing="4">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Humidity (15% weight)" styleClass="status-text" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="humidityFactorLabel" text="15.0 / 15 pts (100%)" styleClass="stat-value" />
                            </HBox>
                            <ProgressBar fx:id="humidityFactorProgress" progress="1.0" maxWidth="Infinity" styleClass="dna-factor-bar" />
                        </VBox>
                    </VBox>

                    <!-- DYNAMIC EXPLANATION -->
                    <VBox spacing="8" styleClass="card-elevated">
                        <Label text="DYNAMIC EXPLANATION" styleClass="section-title" />
                        <Label fx:id="explanationTextLabel"
                               text="Your current conditions score 84/100 (Favorable). Temperature is optimal at 22.4°C, humidity is comfortable (50%), and wind conditions are favourable (8.0 km/h)."
                               styleClass="metric-value-small"
                               wrapText="true" />
                        <HBox fx:id="factorHighlightsBox" spacing="8" />
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
