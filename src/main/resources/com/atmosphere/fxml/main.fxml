<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.atmosphere.controller.MainController"
            styleClass="app-shell">

    <left>
        <VBox spacing="8"
              prefWidth="220"
              minWidth="220"
              maxWidth="220"
              styleClass="sidebar">
            <children>
                <Label text="☁ AtmoSphere" styleClass="app-title" />

                <Label text="Weather Intelligence" styleClass="subtitle">
                    <VBox.margin>
                        <Insets top="2" />
                    </VBox.margin>
                </Label>

                <Separator>
                    <VBox.margin>
                        <Insets top="24" bottom="16" />
                    </VBox.margin>
                </Separator>

                <Button fx:id="dashboardButton"
                        text="◈  Dashboard"
                        maxWidth="Infinity"
                        onAction="#showDashboard"
                        styleClass="nav-btn" />

                <Button fx:id="forecastButton"
                        text="◈  5-Day Forecast"
                        maxWidth="Infinity"
                        onAction="#showForecast"
                        styleClass="nav-btn" />

                <Button fx:id="comparisonButton"
                        text="◈  City Comparison"
                        maxWidth="Infinity"
                        onAction="#showComparison"
                        styleClass="nav-btn" />

                <Button fx:id="weatherDnaButton"
                        text="◈  Weather DNA"
                        maxWidth="Infinity"
                        onAction="#showWeatherDna"
                        styleClass="nav-btn" />

                <Button fx:id="airQualityButton"
                        text="◈  Air Quality"
                        maxWidth="Infinity"
                        onAction="#showAirQuality"
                        styleClass="nav-btn" />

                <Button fx:id="aiInsightsButton"
                        text="◈  AI Insights"
                        maxWidth="Infinity"
                        onAction="#showAiInsights"
                        styleClass="nav-btn" />

                <Button fx:id="activityPlannerButton"
                        text="◈  Activity Planner"
                        maxWidth="Infinity"
                        onAction="#showActivityPlanner"
                        styleClass="nav-btn" />

                <Button fx:id="alertsButton"
                        text="◈  Weather Alerts"
                        maxWidth="Infinity"
                        onAction="#showAlerts"
                        styleClass="nav-btn" />

                <Button fx:id="weatherHistoryButton"
                        text="◈  Weather History"
                        maxWidth="Infinity"
                        onAction="#showWeatherHistory"
                        styleClass="nav-btn" />

                <Region VBox.vgrow="ALWAYS" />

                <Label text="LOCAL TIME" styleClass="section-title" />

                <Label fx:id="clockLabel"
                       text="00:00:00 · Mon, 16 Nov"
                       styleClass="sidebar-clock" />

                <Button text="⚙  Settings"
                        maxWidth="Infinity"
                        onAction="#openSettings"
                        styleClass="settings-button" />
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <padding>
                <Insets top="0" right="0" bottom="0" left="0" />
            </padding>
        </StackPane>
    </center>
</BorderPane>


